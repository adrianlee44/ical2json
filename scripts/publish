#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

usage() {
  echo "Usage: $0 <major|minor|patch> [--execute]" >&2
  echo "  Defaults to a dry run (bumps version and updates CHANGELOG.md locally," >&2
  echo "  but does not commit, tag, push, or publish). Pass --execute to perform" >&2
  echo "  the real release." >&2
  exit 1
}

bump=${1:-}
mode=${2:-}
case "$bump" in
  major|minor|patch) ;;
  *) usage ;;
esac

dry_run=true
case "$mode" in
  "") ;;
  --execute) dry_run=false ;;
  *) usage ;;
esac

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Working tree is not clean. Commit or stash changes before publishing." >&2
  exit 1
fi

current_branch=$(git rev-parse --abbrev-ref HEAD)
if [[ "$current_branch" != "main" ]]; then
  echo "Must be on main branch to publish (currently on $current_branch)." >&2
  exit 1
fi

# Bump version without creating a git commit/tag; lorax needs the tag name below.
new_version=$(npm version "$bump" --no-git-tag-version)
tag="$new_version"

echo "Bumping to $tag"

lorax --tag "$tag" --file CHANGELOG.md --prepend

read -rp "Review/edit CHANGELOG.md now if desired, then press enter to continue..."

if [[ "$dry_run" == true ]]; then
  echo "Dry run: version bumped to $tag and CHANGELOG.md updated locally." >&2
  echo "Nothing was committed, tagged, pushed, or published." >&2
  echo "Review the changes, then re-run with --execute to perform the release." >&2
  exit 0
fi

read -rp "About to commit, tag, push, and publish $tag. Continue? [y/N] " confirm
case "$confirm" in
  y|Y|yes|YES) ;;
  *) echo "Aborted." >&2; exit 1 ;;
esac

git add package.json package-lock.json CHANGELOG.md
git commit -m "chore(build): Build $tag"
git tag -a "$tag" -m "$tag"

git push origin "$current_branch"
git push origin "$tag"

npm publish
